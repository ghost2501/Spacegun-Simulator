<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Spacegun_Simulator</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Versioning (SemVer). Still pre-alpha. -->
    <Version>0.0.4-pre-alpha.10</Version>
    <AssemblyVersion>0.0.4.0</AssemblyVersion>
    <FileVersion>0.0.4.10</FileVersion>
    <InformationalVersion>0.0.4-pre-alpha.10</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Config\GameConfig.json" />
    <None Remove="Config\DevelopmentTuning.json" />
    <None Remove="Config\WeaponsTuning.json" />
    <None Remove="Config\WeaponsUpgrades.json" />
    <None Remove="Config\ProjectilesCatalog.json" />
    <None Remove="Config\Enemies\EnemyDesignations.json" />
    <None Remove="Config\Enemies\EnemyArchetypes.json" />
    <None Remove="Config\Enemies\EnemyDoctrines.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\GameConfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\DevelopmentTuning.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\WeaponsTuning.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\WeaponsUpgrades.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\ProjectilesCatalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\Enemies\EnemyDesignations.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\Enemies\EnemyArchetypes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\Enemies\EnemyDoctrines.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\ascii-art\SideLeft.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Assets\ascii-art\SideRight.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\ascii-art\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
  	<PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
  </ItemGroup>

	<ItemGroup>
		<None Update="Assets\audio\*.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

  <ItemGroup>
    <None Include="Assets\DrumPatterns\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="2.2.1" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
  </ItemGroup>

</Project>
