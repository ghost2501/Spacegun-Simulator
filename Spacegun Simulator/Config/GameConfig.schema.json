{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spacegun Simulator GameConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "TotalWaves": { "type": "integer", "minimum": 1 },
    "BarrelIntegrityLossPerShot": { "type": "number", "minimum": 0 },
    "BaseMuzzleVelocityMs": { "type": "integer", "minimum": 1 },
    "MuzzleVelocityMultiplier": { "type": "number", "minimum": 0.25, "maximum": 3 },
    "TraceResolvedWeaponStats": { "type": "boolean" },
    "BudgetRewardBase": { "type": "number" },
    "BudgetRewardPerWave": { "type": "number" },
    "SteelRewardBase": { "type": "number" },
    "SteelRewardPerWave": { "type": "number" },
    "ExoticRewardBase": { "type": "number" },
    "ExoticRewardPerWave": { "type": "number" },
    "MinBudgetToContinue": { "type": "number" },
    "Modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "PureDeterministicSeed": { "type": "integer" },
        "DisableRandomEventsInPure": { "type": "boolean" },
        "DetectionRcsMultiplierPure": { "type": "number", "minimum": 0 },
        "DetectionRcsMultiplierFull": { "type": "number", "minimum": 0 },
        "TimeBudgetMultiplierPure": { "type": "number", "minimum": 0 },
        "TimeBudgetMultiplierFull": { "type": "number", "minimum": 0 },
        "HitToleranceMultiplierPure": { "type": "number", "minimum": 0 },
        "HitToleranceMultiplierFull": { "type": "number", "minimum": 0 },
        "FractureEnergyDefenseScale": { "type": "number", "minimum": 0 }
      }
    }
  }
}