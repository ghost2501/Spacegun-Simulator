{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spacegun Simulator Enemy Designations",
  "type": "object",
  "additionalProperties": false,
  "description": "Enemy designation pools and static specs used during wave generation. Mis-edits (empty arrays, whitespace-only strings) will cause load failures.",
  "properties": {
    "TargetCountBase": { "type": "integer", "minimum": 1 },
    "TargetCountTierBonus": { "type": "integer", "minimum": 0 },
    "TargetCountRandomMaxExclusive": { "type": "integer", "minimum": 1 },

    "EarlyTypes": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "minItems": 1 },
    "MidTypes": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "minItems": 1 },
    "LateTypes": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "minItems": 1 },

    "CrossSectionRanges": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Min": { "type": "number", "minimum": 0 },
          "Max": { "type": "number", "minimum": 0 }
        },
        "required": ["Min", "Max"]
      }
    },

    "StealthChanceForLateTiers": { "type": "number", "minimum": 0, "maximum": 1 },

    "CampaignNamePrefixes": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "minItems": 1 },
    "CampaignNameSuffixes": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "minItems": 1 }
  },
  "required": [
    "TargetCountBase",
    "TargetCountTierBonus",
    "TargetCountRandomMaxExclusive",
    "EarlyTypes",
    "MidTypes",
    "LateTypes",
    "CrossSectionRanges",
    "StealthChanceForLateTiers",
    "CampaignNamePrefixes",
    "CampaignNameSuffixes"
  ]
}
