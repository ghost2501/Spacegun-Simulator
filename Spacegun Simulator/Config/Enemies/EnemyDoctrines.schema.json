{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spacegun Simulator Enemy Doctrines",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Doctrine": { "type": "string", "minLength": 1 },
          "Name": { "type": "string", "minLength": 1 },
          "Description": { "type": "string" },
          "VelocityMultiplier": { "type": "number", "minimum": 0 },
          "AccelerationMultiplier": { "type": "number", "minimum": 0 },
          "ManeuverabilityMultiplier": { "type": "number", "minimum": 0 },
          "DefenseMultiplier": { "type": "number", "minimum": 0 },
          "OffenseMultiplier": { "type": "number", "minimum": 0 },
          "StealthChanceMultiplier": { "type": "number", "minimum": 0 },
          "RadarCrossSectionMultiplier": { "type": "number", "minimum": 0 }
        },
        "required": [
          "Doctrine",
          "Name",
          "Description",
          "VelocityMultiplier",
          "AccelerationMultiplier",
          "ManeuverabilityMultiplier",
          "DefenseMultiplier",
          "OffenseMultiplier",
          "StealthChanceMultiplier",
          "RadarCrossSectionMultiplier"
        ]
      }
    },
    "PrimaryDoctrinePoolsByArchetypeId": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "GuestDoctrinePoolsByArchetypeId": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    }
  },
  "required": ["Profiles", "PrimaryDoctrinePoolsByArchetypeId", "GuestDoctrinePoolsByArchetypeId"]
}
