{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeaponsUpgrades",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "Upgrades"],
  "properties": {
    "$schema": { "type": "string" },
    "Version": { "type": "integer", "minimum": 1 },
    "Upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Id", "Name", "Description", "Cost"],
        "properties": {
          "Id": { "type": "string", "minLength": 1 },
          "Name": { "type": "string" },
          "Description": { "type": "string" },
          "Cost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Budget", "Steel", "Exotic"],
            "properties": {
              "Budget": { "type": "number", "minimum": 0.0 },
              "Steel": { "type": "number", "minimum": 0.0 },
              "Exotic": { "type": "number", "minimum": 0.0 }
            }
          },
          "Prerequisites": { "type": "array", "items": { "type": "string" } },
          "MinWeaponsTechLevel": { "type": "integer", "minimum": 1 },
          "MinProjectilesTechLevel": { "type": "integer", "minimum": 1 },
          "RequiresGuidanceMod": { "type": "boolean" },
          "RequiresPropulsion": { "type": "string", "enum": ["Chemical", "NonChemical"] },
          "Parameters": { "type": "object", "additionalProperties": { "type": "number" } },
          "Modifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["Key", "Op", "Value"],
              "properties": {
                "Key": { "type": "string", "minLength": 1 },
                "Op": { "type": "string", "enum": ["Add", "Mul", "Set", "ClampMin", "ClampMax"] },
                "Value": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
