{
  "$schema": "./DevelopmentTuning.schema.json",
  "Version": 1,

  "EnemyTuning": {
    "TargetCountBase": 2,
    "TargetCountTierBonus": 1,
    "TargetCountRandomMaxExclusive": 3,

    "EarlyTypes": ["Scout", "Fighter", "Light Cruiser"],
    "MidTypes": ["Cruiser", "Destroyer", "Heavy Fighter"],
    "LateTypes": ["Battlecruiser", "Dreadnought", "Carrier"],

    "CrossSectionRanges": {
      "Scout": { "Min": 10.0, "Max": 30.0 },
      "Fighter": { "Min": 20.0, "Max": 50.0 },
      "Light Cruiser": { "Min": 40.0, "Max": 80.0 },
      "Cruiser": { "Min": 80.0, "Max": 140.0 },
      "Destroyer": { "Min": 100.0, "Max": 180.0 },
      "Heavy Fighter": { "Min": 50.0, "Max": 100.0 },
      "Battlecruiser": { "Min": 150.0, "Max": 250.0 },
      "Dreadnought": { "Min": 250.0, "Max": 400.0 },
      "Carrier": { "Min": 300.0, "Max": 500.0 }
    },

    "StealthChanceForLateTiers": 0.3
  },

  "TierVelocityTuning": {
    "TierEnemyMinVelocity": [25000.0, 45000.0, 80000.0, 140000.0, 220000.0],
