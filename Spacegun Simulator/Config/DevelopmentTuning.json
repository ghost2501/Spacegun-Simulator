    "Length": 0.5,
    "DragCoefficient": 0.3,
    "HasGuidance": false,
    "GuidanceAccuracy": 0.0,
    "ImpactCoupling": 1.0
  },

  "EarthThreatTuning": {
    "EnemyEarthThreatCoupling": 1.0,
    "EarthDestructionThresholdMJ": 0.0
  }
}
