        { "Key": "Projectile.PenetrationMult", "Op": "Mul", "Value": 1.10 },
        { "Key": "Projectile.MassKg", "Op": "Mul", "Value": 1.05 }
      ]
    },

    {
      "Id": "CouplingLiner",
      "Name": "Coupling Liner",
      "Description": "Increase impact coupling (+35%)",
      "Cost": { "Budget": 600, "Steel": 400, "PowerCells": 12, "SpecializedAlloys": 60, "RareEarthElements": 20, "Exotic": 0 },
      "MinProjectilesTechLevel": 2,
      "Prerequisites": ["DensePenetrator"],
      "Modifiers": [
        { "Key": "Projectile.ImpactCouplingMult", "Op": "Mul", "Value": 1.35 }
      ]
    },

    {
      "Id": "ProjectileArmor",
      "Name": "Projectile Armor",
      "Description": "Increase projectile defense rating (+0.10)",
      "Cost": { "Budget": 480, "Steel": 420, "PowerCells": 9, "SpecializedAlloys": 30, "RareEarthElements": 11, "AdvancedOre": 36, "Exotic": 0 },
      "MinProjectilesTechLevel": 3,
      "Modifiers": [
        { "Key": "Projectile.DefenseRating01", "Op": "Add", "Value": 0.10 },
        { "Key": "Projectile.DefenseRating01", "Op": "ClampMax", "Value": 0.90 }
      ]
    },

    {
      "Id": "LaunchOverclock",
      "Name": "Launch Overclock",
      "Description": "Increase max launch velocity (+60%). Increases barrel wear (+35%).",
      "Cost": { "Budget": 950, "Steel": 650, "PowerCells": 18, "SpecializedAlloys": 70, "RareEarthElements": 24, "AdvancedOre": 60, "Exotic": 0 },
      "MinWeaponsTechLevel": 3,
      "Parameters": { "WearMultiplier": 1.35 },
      "Modifiers": [
        { "Key": "Shot.MaxLaunchVelocityMs", "Op": "Mul", "Value": 1.6 },
        { "Key": "Shot.MaxLaunchVelocityMs", "Op": "ClampMin", "Value": 1.0 }
      ]
    },

    {
      "Id": "ChamberPolish",
      "Name": "Chamber Polish",
      "Description": "Slightly increase max launch velocity (+10%). Minor additional wear (+5%).",
      "Cost": { "Budget": 260, "Steel": 180, "Exotic": 0 },
      "MinWeaponsTechLevel": 1,
      "Parameters": { "WearMultiplier": 1.05 },
      "Modifiers": [
        { "Key": "Shot.MaxLaunchVelocityMs", "Op": "Mul", "Value": 1.10 },
        { "Key": "Shot.MaxLaunchVelocityMs", "Op": "ClampMin", "Value": 1.0 }
      ]
    },

    {
      "Id": "FractureLiner",
      "Name": "Fracture Liner",
      "Description": "Increase effective fracture energy (+15%).",
      "Cost": { "Budget": 420, "Steel": 260, "PowerCells": 3, "Exotic": 0 },
      "MinWeaponsTechLevel": 2,
      "Modifiers": [
        { "Key": "Shot.EffectiveFractureEnergyMJ", "Op": "Mul", "Value": 1.15 }
      ]
    }
  ]
}

