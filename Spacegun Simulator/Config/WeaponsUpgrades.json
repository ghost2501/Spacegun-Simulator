      "Description": "Reduce projectile mass by 8% (improves velocity envelope)",
      "Cost": { "Budget": 380, "Steel": 200, "SpecializedAlloys": 28, "RareEarthElements": 10, "Exotic": 0 },
      "MinProjectilesTechLevel": 2,
      "Modifiers": [
        { "Key": "Projectile.MassKg", "Op": "Mul", "Value": 0.92 }
      ]
    },

    {
      "Id": "DensePenetrator",
      "Name": "Dense Penetrator",
      "Description": "Increase penetration (+10%), slightly heavier projectile (+5%)",
      "Cost": { "Budget": 520, "Steel": 350, "SpecializedAlloys": 45, "RareEarthElements": 15, "Exotic": 0 },
